# ===========================================================================
# Gabinet — wzorzec pliku środowiskowego.
#
#   cp .env.example .env
#   cd backend && php artisan key:generate
#
# JEDEN plik `.env` na całe repozytorium (decyzja D-2026-08-07-03): czyta go
# zarówno `docker-compose.yml`, jak i Laravel (`bootstrap/app.php` wskazuje
# katalog nadrzędny). Dwa pliki rozjeżdżają się po pierwszej zmianie hasła.
#
# ZASADA TWARDA: w tym pliku NIE MA WARTOŚCI SEKRETÓW. Puste `=` oznacza
# „wpisuje człowiek u siebie / w sekretach środowiska". Wyciek = rotacja
# klucza + wpis w docs/DECYZJE.md (WYTYCZNE-PRACY.md §7).
# ===========================================================================

# --- aplikacja -------------------------------------------------------------
APP_NAME=Gabinet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8098
APP_TIMEZONE=UTC
APP_LOCALE=pl
APP_FALLBACK_LOCALE=pl
APP_FAKER_LOCALE=pl_PL

# Strefa prezentacji. W bazie ZAWSZE UTC (CLAUDE.md §5) — ta wartość dotyczy
# wyłącznie tego, co widzi człowiek w panelu, w mailu i w pliku .ics.
GABINET_STREFA_PREZENTACJI=Europe/Warsaw

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- baza danych (PostgreSQL) ---------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=gabinet
DB_USERNAME=gabinet
# Lokalnie dowolne (np. `openssl rand -base64 24`); na serwerze wpisuje człowiek.
DB_PASSWORD=

# Port, pod którym baza jest widoczna NA HOŚCIE (tylko 127.0.0.1) — do psql
# i do uruchamiania testów z Windows bez wchodzenia do kontenera.
GABINET_PORT_POSTGRES=55442

# --- Redis / kolejki -------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
GABINET_PORT_REDIS=56389

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
BROADCAST_CONNECTION=log

HORIZON_PREFIX=gabinet_horizon:

# --- HTTP ------------------------------------------------------------------
# Port nginx-a na hoście (tylko 127.0.0.1).
GABINET_PORT_HTTP=8098

# --- Konta Niepodzielni (Keycloak / OIDC) ---------------------------------
# Kontrakt: repo `konta`, docs/INTEGRACJA-KONTRAKT.md.
# UWAGA §3a kontraktu: DWA adresy IdP. Publiczny widzi przeglądarka i tylko
# względem niego wolno walidować `iss`; wewnętrzny widzi serwer (token, JWKS).
KEYCLOAK_PUBLIC_ISSUER=https://localhost:8443/realms/niepodzielni
KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/realms/niepodzielni
KEYCLOAK_CLIENT_ID=gabinet
# Klient poufny — sekret wydaje człowiek przy deployu, NIGDY nie wchodzi do repo.
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=http://localhost:8098/auth/callback
# Wymagana audiencja access tokena (§4.4 kontraktu) — token wystawiony dla
# innego klienta MUSI zostać odrzucony.
KEYCLOAK_EXPECTED_AUDIENCE=gabinet
# Ścieżka do lokalnego CA Caddy'ego ze stosu `konta` (lokalny TLS bez ACME).
# Puste = zaufanie systemowe. Nigdy nie ustawiaj tu „wyłącz weryfikację".
KEYCLOAK_CA_BUNDLE=

# Konto usługowe do zakładania kont pacjentów przez Admin API (F3).
# Sekret ma klasę wrażliwości konta administracyjnego — patrz kontrakt §5.
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=

# --- Stripe: DWA KONTA (CLAUDE.md §3) -------------------------------------
# Konto FUNDACYJNE: konsultacja niskopłatna, asystent zdrowienia.
STRIPE_FUNDACJA_KEY=
STRIPE_FUNDACJA_SECRET=
STRIPE_FUNDACJA_WEBHOOK_SECRET=

# Konto KOMERCYJNE: konsultacja pełnopłatna, diagnoza ADHD.
STRIPE_KOMERCJA_KEY=
STRIPE_KOMERCJA_SECRET=
STRIPE_KOMERCJA_WEBHOOK_SECRET=

STRIPE_WALUTA=PLN

# --- SMS (SMSAPI) ----------------------------------------------------------
SMSAPI_TOKEN=
SMSAPI_NADAWCA=Niepodzielni
# Miesięczny limit kosztu w groszach — po przekroczeniu wysyłka staje (spec M5/6).
SMSAPI_LIMIT_MIESIECZNY_GR=

# --- Poczta transakcyjna ---------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=kontakt@niepodzielni.com
MAIL_FROM_NAME="Fundacja Niepodzielni"

# --- Wideo (dostawca do wyboru: docs/analizy/wideo-jitsi-vs-whereby.md) ----
WIDEO_DOSTAWCA=
WIDEO_API_KLUCZ=
WIDEO_BAZOWY_URL=

# --- Bezpiecznik środowisk nieprodukcyjnych --------------------------------
# TWARDA blokada wysyłki mail/SMS poza produkcją (CLAUDE.md §10, spec M5/18).
# `true` na dev i staging. Zdejmuje ją WYŁĄCZNIE świadoma zmiana na produkcji.
GABINET_BLOKADA_WYSYLKI=true
