includes:
    - vendor/larastan/larastan/extension.neon
    # Bez tej wtyczki PHPStan nie wie, że `$this` w domknięciu Pesta jest
    # instancją Tests\TestCase — i zgłasza „undefined method get()" przy
    # każdym teście HTTP.
    - vendor/pestphp/pest-plugin-phpstan/extension.neon

parameters:
    # Poziom maksymalny od pierwszego dnia. Podniesienie poziomu na projekcie,
    # który ma już 200 plików, kosztuje wielokrotnie więcej niż utrzymanie go
    # od pustego szkieletu (docs/DECYZJE.md, D-2026-08-07-05).
    level: max

    paths:
        - app
        - config
        - database
        - routes
        - tests

    treatPhpDocTypesAsCertain: false


    # Jedyne wyciszenia — obie dotyczą tarcia Pest <-> PHPStan w PLIKACH TESTÓW,
    # nie kodu produkcyjnego, i obie są wąsko zakresowane.
    #
    # 1. `test()` zwraca unię TestCall|HigherOrderTapProxy; statyka nie widzi na
    #    niej metod klienta HTTP, choć w czasie działania są. Wersja z typowaną
    #    funkcją pomocniczą ROZWALA łańcuch wywołań Pest (zmierzone: 5 testów
    #    przestaje przechodzić), więc lekarstwo byłoby gorsze od choroby.
    # 2. Nazwy bramek zawierają KROPKĘ (`panel.koordynacji`), więc czytamy je
    #    jako offset tablicy z `->json('bramki')`, którego typu statyka nie zna.
    ignoreErrors:
        -
            identifier: method.notFound
            path: tests/*
        -
            identifier: offsetAccess.nonOffsetAccessible
            path: tests/*
