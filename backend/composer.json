{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "fundacja-niepodzielni/gabinet",
    "type": "project",
    "description": "Gabinet — system rezerwacji wizyt Fundacji Niepodzielni (backend).",
    "keywords": ["laravel", "niepodzielni", "gabinet", "rezerwacje"],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "dedoc/scramble": "^0.13.39",
        "laravel/framework": "^13.24",
        "laravel/horizon": "^5.48",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "bramka": [
            "@pint",
            "@statyka",
            "@test"
        ],
        "pint": "pint --test",
        "statyka": "phpstan analyse --memory-limit=1G",
        "test": [
            "@php artisan config:clear --ansi",
            "pest"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.4.24",
            "ext-pcntl": "8.4.0",
            "ext-posix": "8.4.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
